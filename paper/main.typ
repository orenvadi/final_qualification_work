import React, { useEffect, useState, useMemo } from "react";
import { ConnectionProvider, WalletProvider, useAnchorWallet, useConnection } from "@solana/wallet-adapter-react";
import { WalletModalProvider, WalletMultiButton } from "@solana/wallet-adapter-react-ui";
import { PhantomWalletAdapter } from "@solana/wallet-adapter-wallets";
import { Program, AnchorProvider, utils, web3 } from "@coral-xyz/anchor";
import { PublicKey, SystemProgram } from "@solana/web3.js";
import "@solana/wallet-adapter-react-ui/styles.css";
import idl from "./e_voting.json";

export default function App() {
  const endpoint = web3.clusterApiUrl("devnet");
  const wallets = useMemo(() => [new PhantomWalletAdapter()], []);

  return (
    <ConnectionProvider endpoint={endpoint}>
      <WalletProvider wallets={wallets} autoConnect>
        <WalletModalProvider>
          <div style={{ maxWidth: "800px", margin: "0 auto", padding: "20px" }}>
            <div style={{ display: "flex", justifyContent: "space-between", marginBottom: "20px" }}>
              <h1>E-Voting DApp</h1>
              <WalletMultiButton />
            </div>
            <VotingDashboard />
          </div>
        </WalletModalProvider>
      </WalletProvider>
    </ConnectionProvider>
  );
}

function VotingDashboard() {
  const { connection } = useConnection();
  const wallet = useAnchorWallet();
  const [proposals, setProposals] = useState<any[]>([]);
  const [description, setDescription] = useState("");
  const [pid, setPid] = useState(1);

  const program = useMemo(() => {
    if (!wallet) return null;
    const provider = new AnchorProvider(connection, wallet, { preflightCommitment: "processed" });
    return new Program(idl as any, provider);
  }, [connection, wallet]);

  const fetchProposals = async () => {
    if (!program) return;
    try {
      const allProposals = await program.account.proposal.all();
      setProposals(allProposals);
    } catch (err) { console.error(err); }
  };

  useEffect(() => { fetchProposals(); }, [program]);

  const handleCreateProposal = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!program || !wallet) return;
    try {
      const [proposalPda] = PublicKey.findProgramAddressSync(
        [utils.bytes.utf8.encode("proposal"), wallet.publicKey.toBuffer(), new Uint8Array([pid])],
        program.programId,
      );
      await program.methods.create(pid, description)
        .accounts({ proposal: proposalPda, user: wallet.publicKey, systemProgram: SystemProgram.programId })
        .rpc();
      alert("Proposal created!");
      setDescription(""); setPid(pid + 1); fetchProposals();
    } catch (err) { console.error(err); }
  };

  const handleVote = async (proposalPubkey: PublicKey, voteType: "yes" | "no") => {
    if (!program || !wallet) return;
    try {
      const [votePda] = PublicKey.findProgramAddressSync(
        [utils.bytes.utf8.encode("vote"), proposalPubkey.toBuffer(), wallet.publicKey.toBuffer()],
        program.programId,
      );
      const method = voteType === "yes" ? program.methods.voteYes() : program.methods.voteNo();
      await method.accounts({ proposal: proposalPubkey, user: wallet.publicKey, vote: votePda, systemProgram: SystemProgram.programId }).rpc();
      alert(`Voted ${voteType} successfully!`);
      fetchProposals();
    } catch (err: any) {
      if (err.message.includes("already in use")) alert("Already voted!");
    }
  };

  if (!wallet) return <h3>Please connect your wallet</h3>;

  return (
    <div>
      <div style={{ padding: "20px", border: "1px solid #ccc", marginBottom: "20px" }}>
        <h2>Create a Proposal</h2>
        <form onSubmit={handleCreateProposal}>
          <label>PID: <input type="number" value={pid} onChange={(e) => setPid(Number(e.target.value))} required /></label><br/><br/>
          <label>Description: <input type="text" value={description} onChange={(e) => setDescription(e.target.value)} required /></label><br/><br/>
          <button type="submit">Create Proposal</button>
        </form>
      </div>

      <h2>Active Proposals</h2>
      {proposals.length === 0 ? <p>No proposals found.</p> : (
        <div style={{ display: "grid", gap: "15px" }}>
          {proposals.map((p, i) => (
            <div key={i} style={{ padding: "15px", border: "1px solid #eee", background: "#f9f9f9" }}>
              <h3>#{p.account.pid} - {p.account.description}</h3>
              <p>Status: {p.account.ongoing ? "Active" : "Closed"}</p>
              <div>
                <span style={{ color: "green" }}>YES: {p.account.yesVotes}</span>
                <button onClick={() => handleVote(p.publicKey, "yes")}>Vote YES</button>
              </div>
              <div>
                <span style={{ color: "red" }}>NO: {p.account.noVotes}</span>
                <button onClick={() => handleVote(p.publicKey, "no")}>Vote NO</button>
              </div>
            </div>
          ))}
        </div>
      )}
    </div>
  );
}
